# Example only. Run ./scripts/init-env.sh to generate untracked local passwords.
MYSQL_DATABASE=group_photo
MYSQL_USER=group_photo
MYSQL_PASSWORD=replace-with-local-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-local-random-password
DB_HOST=127.0.0.1
DB_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=5173
MINIO_ROOT_USER=group-photo-local
MINIO_ROOT_PASSWORD=replace-with-local-random-password
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=group-photo-private
# Required only for docker-compose.storage.yml. Supply a verified image reference.
MINIO_IMAGE=
