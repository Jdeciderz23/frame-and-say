{
  "name": "group-photo-consensus-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
